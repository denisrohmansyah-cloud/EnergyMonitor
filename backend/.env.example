# Server
NODE_ENV=development
PORT=3000

# Browser origin(s), exact and comma-separated. Example:
# https://denisrohmansyah-cloud.github.io
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,https://denisrohmansyah-cloud.github.io

# Signed login cookie. Use a unique random secret with at least 32 characters.
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SESSION_TTL_SECONDS=7200

# Cookies must be Secure in production. For cross-site GitHub Pages -> API, use SameSite=None.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Google Apps Script Web App deployment URL ending in /exec
APPS_SCRIPT_URL=

# Must match the value saved using "Energy Monitor -> Atur API Key Backend"
APPS_SCRIPT_API_KEY=

# Admin key for creating customers and assigning one device.
# Generate a separate random secret. Do not put this in frontend JavaScript.
ADMIN_API_KEY=

# Mark a device offline if its last reading is older than this many seconds.
DEVICE_OFFLINE_AFTER_SECONDS=180
